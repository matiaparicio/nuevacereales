---
const services = [
  {
    number: '01',
    title: 'Corretaje',
    description: 'Intermediación profesional en la compra y venta de granos, cereales, oleaginosas y subproductos. Conectamos productores, acopiadores, exportadores e industria con criterio y transparencia.',
    icon: 'M3 3h18v18H3V3zm2 2v14h14V5H5zm2 2h10v2H7V7zm0 4h10v2H7v-2zm0 4h7v2H7v-2z',
  },
  {
    number: '02',
    title: 'Asesoramiento Legal',
    description: 'Acompañamiento en los aspectos jurídicos de cada operación: contratos de compraventa, condiciones, cláusulas particulares y cumplimiento normativo del sector.',
    icon: 'M12 2L3 7v11c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V7l-9-5zm0 2.2L18.5 8 12 11.8 5.5 8 12 4.2zM5 9.5l6 3.5v7l-6-3v-7.5zm8 10.5v-7l6-3.5V17l-6 3z',
  },
  {
    number: '03',
    title: 'Comercial',
    description: 'Estrategia comercial para optimizar precios, timing de mercado y canales de colocación. Seguimiento permanente de pizarras, FAS, FOB y tendencias del mercado internacional.',
    icon: 'M3 3v18h18v-2H5V3H3zm15 6l-5 5-3-3-4 4 1.4 1.4L10 11.8l3 3 6.4-6.4L18 9z',
  },
  {
    number: '04',
    title: 'Financiero y Administrativo',
    description: 'Asistencia en cobros, pagos, liquidaciones, cuentas corrientes y toda la operatoria administrativa que requiere la comercialización de granos.',
    icon: 'M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2zm0 4v10h16V8H4zm2 2h4v2H6v-2zm0 4h8v2H6v-2z',
  },
  {
    number: '05',
    title: 'Logística',
    description: 'Coordinación de cargas, cupos, transporte, recepción en destino y toda la cadena logística hasta la entrega efectiva del producto en condiciones.',
    icon: 'M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm11.5-9.5l1.96 2.5H17V9h.5zm.5 9.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z',
  },
];
---

<section id="servicios" class="relative py-32 md:py-40 bg-ink-900 overflow-hidden">
  <!-- Subtle texture -->
  <div class="absolute inset-0 opacity-[0.02] pointer-events-none"
       style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;">
  </div>

  <div class="relative max-w-7xl mx-auto px-6 lg:px-10">
    <!-- Header -->
    <div class="grid grid-cols-12 gap-8 mb-20">
      <div class="col-span-12 md:col-span-4">
        <div class="svc-label flex items-center gap-3 mb-6">
          <span class="w-8 h-px bg-wheat-400"></span>
          <span class="text-wheat-400 text-xs font-mono tracking-[0.25em] uppercase">
            02 · Servicios
          </span>
        </div>
      </div>
      <div class="col-span-12 md:col-span-8">
        <h2 class="svc-title font-display text-cream-50 text-4xl md:text-5xl lg:text-6xl leading-[1.05] tracking-tight">
          Mucho más que<br />
          <em class="text-wheat-400 font-normal">intermediación.</em>
        </h2>
        <p class="svc-sub mt-8 text-cream-100/70 text-lg md:text-xl max-w-2xl leading-relaxed font-light">
          Brindamos una cobertura integral de la operatoria comercial agropecuaria,
          acompañando a nuestros clientes en cada etapa del negocio.
        </p>
      </div>
    </div>

    <!-- Grid de servicios -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-teal-800/30">
      {
        services.map((service) => (
          <div class="svc-card group relative bg-ink-900 p-8 md:p-10 hover:bg-teal-900/30 transition-colors duration-500 overflow-hidden">
            <!-- Number -->
            <div class="font-mono text-wheat-400/60 text-xs tracking-[0.3em] mb-6">
              {service.number}
            </div>

            <!-- Icon -->
            <div class="mb-8 text-wheat-400">
              <svg class="w-10 h-10" viewBox="0 0 24 24" fill="currentColor">
                <path d={service.icon} />
              </svg>
            </div>

            <!-- Title -->
            <h3 class="font-display text-3xl md:text-4xl text-cream-50 mb-4 leading-tight">
              {service.title}
            </h3>

            <!-- Description -->
            <p class="text-cream-100/70 leading-relaxed text-sm md:text-base">
              {service.description}
            </p>

            <!-- Hover line -->
            <div class="absolute bottom-0 left-0 h-px w-0 bg-wheat-400 transition-all duration-500 group-hover:w-full" />
          </div>
        ))
      }

      <!-- Última card con CTA -->
      <div class="svc-card relative bg-wheat-400 p-8 md:p-10 flex flex-col justify-between min-h-[280px]">
        <div>
          <div class="font-mono text-ink-900/60 text-xs tracking-[0.3em] mb-6">
            06
          </div>
          <h3 class="font-display text-3xl md:text-4xl text-ink-900 leading-tight">
            ¿Necesitás asesoramiento?
          </h3>
        </div>
        <a
          href="#contacto"
          class="group inline-flex items-center gap-3 text-ink-900 font-semibold tracking-wide uppercase text-sm mt-8"
        >
          Hablemos
          <svg class="w-5 h-5 transition-transform group-hover:translate-x-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.from('.svc-label', {
    opacity: 0,
    x: -20,
    duration: 0.8,
    scrollTrigger: {
      trigger: '.svc-label',
      start: 'top 85%',
    },
  });

  gsap.from('.svc-title', {
    opacity: 0,
    y: 40,
    duration: 1,
    scrollTrigger: {
      trigger: '.svc-title',
      start: 'top 85%',
    },
  });

  gsap.from('.svc-sub', {
    opacity: 0,
    y: 20,
    duration: 0.8,
    scrollTrigger: {
      trigger: '.svc-sub',
      start: 'top 85%',
    },
  });

  gsap.from('.svc-card', {
    opacity: 0,
    y: 40,
    duration: 0.7,
    stagger: 0.1,
    scrollTrigger: {
      trigger: '.svc-card',
      start: 'top 80%',
    },
  });
</script>
