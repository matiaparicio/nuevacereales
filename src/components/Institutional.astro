---
// Sección institucional: historia y filosofía de la empresa
---

<section id="institucional" class="relative py-32 md:py-40 bg-cream-50 overflow-hidden">
  <!-- Decorative element -->
  <div class="absolute top-0 right-0 w-1/3 h-full opacity-[0.03] pointer-events-none">
    <img
      src="https://images.unsplash.com/photo-1574943320219-553eb213f72d?auto=format&fit=crop&w=1200&q=80"
      alt=""
      class="w-full h-full object-cover"
    />
  </div>

  <div class="relative max-w-7xl mx-auto px-6 lg:px-10">
    <!-- Section header -->
    <div class="grid grid-cols-12 gap-8 mb-20">
      <div class="col-span-12 md:col-span-4">
        <div class="inst-label flex items-center gap-3 mb-6">
          <span class="w-8 h-px bg-wheat-500"></span>
          <span class="text-wheat-700 text-xs font-mono tracking-[0.25em] uppercase">
            01 · Institucional
          </span>
        </div>
      </div>
      <div class="col-span-12 md:col-span-8">
        <h2 class="inst-title font-display text-ink-900 text-4xl md:text-5xl lg:text-6xl leading-[1.05] tracking-tight">
          Experiencia, aval y<br />
          dedicación en cada<br />
          <em class="text-teal-700 font-normal">operación.</em>
        </h2>
      </div>
    </div>

    <!-- Content grid -->
    <div class="grid grid-cols-12 gap-8 md:gap-16">
      <!-- Columna izquierda: texto principal -->
      <div class="col-span-12 md:col-span-7 space-y-8">
        <p class="inst-p font-display text-2xl md:text-3xl leading-relaxed text-ink-800 italic">
          "El objetivo primordial es lograr para nuestros clientes competitividad y eficiencia."
        </p>

        <div class="space-y-6 text-ink-700 leading-relaxed text-base md:text-lg max-w-2xl">
          <p class="inst-p">
            Desde 2007 desarrollamos la actividad de <strong class="text-ink-900 font-semibold">corretaje de granos, cereales, oleaginosas y subproductos</strong>, con experiencia y aval en el rubro.
          </p>
          <p class="inst-p">
            Todos los que integramos Nueva Cereales S.A. trabajamos con esfuerzo y dedicación, entendiendo que cada operación requiere criterio, conocimiento del mercado y una red de confianza construida a lo largo de los años.
          </p>
          <p class="inst-p">
            Nuestra actividad no se limita exclusivamente a la intermediación en la compra y venta de granos: brindamos además un <strong class="text-ink-900 font-semibold">completo asesoramiento integral</strong> en todos los aspectos que rodean a la operatoria comercial agropecuaria.
          </p>
        </div>
      </div>

      <!-- Columna derecha: datos clave -->
      <div class="col-span-12 md:col-span-5">
        <div class="sticky top-32 space-y-px bg-teal-700">
          <div class="inst-fact bg-cream-50 p-8 md:p-10">
            <div class="text-xs font-mono tracking-widest uppercase text-wheat-700 mb-3">
              Fundación
            </div>
            <div class="font-display text-5xl text-ink-900">2007</div>
            <div class="mt-2 text-sm text-ink-700">
              Más de 19 años en el mercado
            </div>
          </div>
          <div class="inst-fact bg-cream-50 p-8 md:p-10">
            <div class="text-xs font-mono tracking-widest uppercase text-wheat-700 mb-3">
              Especialidad
            </div>
            <div class="font-display text-2xl md:text-3xl text-ink-900 leading-tight">
              Granos, cereales, oleaginosas y subproductos
            </div>
          </div>
          <div class="inst-fact bg-cream-50 p-8 md:p-10">
            <div class="text-xs font-mono tracking-widest uppercase text-wheat-700 mb-3">
              Plaza
            </div>
            <div class="font-display text-2xl md:text-3xl text-ink-900 leading-tight">
              Bahía Blanca
            </div>
            <div class="mt-2 text-sm text-ink-700">
              Sudoeste bonaerense · Puerto de Ingeniero White
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Label
  gsap.from('.inst-label', {
    opacity: 0,
    x: -20,
    duration: 0.8,
    scrollTrigger: {
      trigger: '.inst-label',
      start: 'top 85%',
    },
  });

  // Título
  gsap.from('.inst-title', {
    opacity: 0,
    y: 40,
    duration: 1,
    scrollTrigger: {
      trigger: '.inst-title',
      start: 'top 85%',
    },
  });

  // Párrafos stagger
  gsap.from('.inst-p', {
    opacity: 0,
    y: 20,
    duration: 0.8,
    stagger: 0.15,
    scrollTrigger: {
      trigger: '.inst-p',
      start: 'top 85%',
    },
  });

  // Facts cards
  gsap.from('.inst-fact', {
    opacity: 0,
    y: 30,
    duration: 0.7,
    stagger: 0.12,
    scrollTrigger: {
      trigger: '.inst-fact',
      start: 'top 85%',
    },
  });
</script>
