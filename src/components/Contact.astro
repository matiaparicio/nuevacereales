---
// PLACEHOLDER: email pendiente de definir
const CONTACT_EMAIL = 'contacto@nuevacereales.com.ar'; // TODO: reemplazar por email real
const CONTACT_PHONE = '+5492914549191';
const CONTACT_PHONE_DISPLAY = '+54 9 291 454-9191';
const ADDRESS = 'Holdich 609, Bahía Blanca';
const ADDRESS_FULL = 'Holdich 609, Bahía Blanca, Provincia de Buenos Aires, Argentina';
const MAPS_QUERY = encodeURIComponent(ADDRESS_FULL);

// Construimos el mailto con asunto predefinido
const mailtoLink = `mailto:${CONTACT_EMAIL}?subject=Consulta%20desde%20la%20web`;
---

<section id="contacto" class="relative py-32 md:py-40 bg-cream-50 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-10">
    <!-- Header -->
    <div class="grid grid-cols-12 gap-8 mb-20">
      <div class="col-span-12 md:col-span-4">
        <div class="cnt-label flex items-center gap-3 mb-6">
          <span class="w-8 h-px bg-wheat-500"></span>
          <span class="text-wheat-700 text-xs font-mono tracking-[0.25em] uppercase">
            03 · Contacto
          </span>
        </div>
      </div>
      <div class="col-span-12 md:col-span-8">
        <h2 class="cnt-title font-display text-ink-900 text-4xl md:text-5xl lg:text-6xl leading-[1.05] tracking-tight">
          Conversemos sobre<br />
          su <em class="text-teal-700 font-normal">operación.</em>
        </h2>
      </div>
    </div>

    <!-- Grid de contacto -->
    <div class="grid grid-cols-12 gap-8 md:gap-0">
      <!-- Columna izquierda: información -->
      <div class="col-span-12 md:col-span-7 md:pr-16 space-y-12">
        <!-- Dirección -->
        <div class="cnt-item group">
          <div class="flex items-start gap-5">
            <div class="flex-shrink-0 w-10 h-10 border border-teal-700/30 flex items-center justify-center">
              <svg class="w-5 h-5 text-teal-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <div>
              <div class="text-xs font-mono tracking-widest uppercase text-wheat-700 mb-2">
                Oficina
              </div>
              <div class="font-display text-2xl md:text-3xl text-ink-900 mb-1">
                Holdich 609
              </div>
              <div class="text-ink-700">
                Bahía Blanca, Buenos Aires, Argentina
              </div>
              <a
                href={`https://www.google.com/maps/search/?api=1&query=${MAPS_QUERY}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 mt-3 text-sm text-teal-700 hover:text-teal-800 font-medium transition-colors"
              >
                Ver en Google Maps
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Teléfono -->
        <div class="cnt-item">
          <div class="flex items-start gap-5">
            <div class="flex-shrink-0 w-10 h-10 border border-teal-700/30 flex items-center justify-center">
              <svg class="w-5 h-5 text-teal-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
            </div>
            <div>
              <div class="text-xs font-mono tracking-widest uppercase text-wheat-700 mb-2">
                Teléfono
              </div>
              <a
                href={`tel:${CONTACT_PHONE}`}
                class="font-display text-2xl md:text-3xl text-ink-900 hover:text-teal-700 transition-colors"
              >
                {CONTACT_PHONE_DISPLAY}
              </a>
            </div>
          </div>
        </div>

        <!-- Email -->
        <div class="cnt-item">
          <div class="flex items-start gap-5">
            <div class="flex-shrink-0 w-10 h-10 border border-teal-700/30 flex items-center justify-center">
              <svg class="w-5 h-5 text-teal-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </div>
            <div>
              <div class="text-xs font-mono tracking-widest uppercase text-wheat-700 mb-2">
                Email
              </div>
              <a
                href={mailtoLink}
                class="font-display text-2xl md:text-3xl text-ink-900 hover:text-teal-700 transition-colors break-all"
              >
                {CONTACT_EMAIL}
              </a>
              <!-- TODO: reemplazar por email real cuando se defina -->
            </div>
          </div>
        </div>

        <!-- Horarios -->
        <div class="cnt-item">
          <div class="flex items-start gap-5">
            <div class="flex-shrink-0 w-10 h-10 border border-teal-700/30 flex items-center justify-center">
              <svg class="w-5 h-5 text-teal-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <div>
              <div class="text-xs font-mono tracking-widest uppercase text-wheat-700 mb-2">
                Horario de atención
              </div>
              <div class="space-y-1">
                <div class="flex items-baseline gap-4">
                  <span class="font-display text-xl text-ink-900 min-w-[140px]">Lunes a Viernes</span>
                  <span class="text-ink-700 font-mono text-sm">08:30 – 12:30 h</span>
                </div>
                <div class="flex items-baseline gap-4">
                  <span class="font-display text-xl text-ink-900 min-w-[140px]">&nbsp;</span>
                  <span class="text-ink-700 font-mono text-sm">15:30 – 19:00 h</span>
                </div>
                <div class="flex items-baseline gap-4 pt-2">
                  <span class="font-display text-xl text-ink-700/60 min-w-[140px]">Sáb. y Dom.</span>
                  <span class="text-ink-700/60 font-mono text-sm">Cerrado</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Columna derecha: CTA card -->
      <div class="col-span-12 md:col-span-5">
        <div class="cnt-cta sticky top-32 bg-teal-700 text-cream-50 p-10 md:p-12">
          <div class="text-xs font-mono tracking-widest uppercase text-wheat-400 mb-6">
            Consultas
          </div>
          <h3 class="font-display text-3xl md:text-4xl leading-tight mb-6">
            Enviá tu consulta por email
          </h3>
          <p class="text-cream-100/80 leading-relaxed mb-10">
            Respondemos a la brevedad en horarios de oficina.
            Contanos sobre tu operación y te asesoramos en lo que necesites.
          </p>

          <a
            href={mailtoLink}
            class="group inline-flex items-center justify-center gap-3 w-full px-8 py-4 bg-wheat-400 text-ink-900 font-semibold tracking-wide uppercase text-sm hover:bg-wheat-300 transition-colors"
          >
            Escribinos
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>

          <div class="mt-8 pt-8 border-t border-cream-50/20">
            <div class="text-xs font-mono tracking-widest uppercase text-wheat-400/80 mb-3">
              O llamanos
            </div>
            <a
              href={`tel:${CONTACT_PHONE}`}
              class="font-display text-2xl hover:text-wheat-400 transition-colors"
            >
              {CONTACT_PHONE_DISPLAY}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.from('.cnt-label', {
    opacity: 0,
    x: -20,
    duration: 0.8,
    scrollTrigger: {
      trigger: '.cnt-label',
      start: 'top 85%',
    },
  });

  gsap.from('.cnt-title', {
    opacity: 0,
    y: 40,
    duration: 1,
    scrollTrigger: {
      trigger: '.cnt-title',
      start: 'top 85%',
    },
  });

  gsap.from('.cnt-item', {
    opacity: 0,
    y: 30,
    duration: 0.7,
    stagger: 0.12,
    scrollTrigger: {
      trigger: '.cnt-item',
      start: 'top 85%',
    },
  });

  gsap.from('.cnt-cta', {
    opacity: 0,
    y: 40,
    duration: 0.9,
    scrollTrigger: {
      trigger: '.cnt-cta',
      start: 'top 85%',
    },
  });
</script>
